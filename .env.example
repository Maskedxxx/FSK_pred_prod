# =============================================================================
# FSK Defect Analysis Bot - Environment Variables
# =============================================================================
# Скопируйте этот файл как .env и заполните значения:
#   cp .env.example .env
#
# Для Docker: .env файл автоматически загружается через docker-compose
# =============================================================================

# Токен Telegram бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Уровень логирования (опционально, по умолчанию INFO)
# Варианты: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# OCR Worker (внешний сервис на хосте)
# =============================================================================
# URL OCR Worker сервиса (host.docker.internal для доступа к хосту из Docker)
OCR_WORKER_URL=http://host.docker.internal:8765

# Таймаут запроса к OCR Worker в секундах (для больших PDF)
OCR_WORKER_TIMEOUT_SECONDS=600
