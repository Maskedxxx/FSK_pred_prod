# =============================================================================
# Docker Build Context Exclusions
# =============================================================================

# Git
.git
.gitignore

# IDE и редакторы
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Тестирование
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Документация
docs/
*.md
!README.md

# Временные файлы и кэш
*.log
*.tmp
*.temp
.cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Примеры и тестовые данные
examples/
test_data/
*.pdf
*.xlsx

# Docker (не копируем сам Dockerfile в образ повторно)
Dockerfile
docker-compose*.yml
.dockerignore

# Environment (безопасность - не копируем .env в образ)
# BOT_TOKEN передаётся через env_file в docker-compose
.env
.env.*
!.env.example

# Claude
CLAUDE.md
